#X text 109 363 <- noise comes from here;
#X text 102 439 <- (random 100/100)^5 is the way to make lower random values appear more often;
#X text 115 417 <- makes envelope decay a bit shorter than 1 ms;
#X text 112 472 <- defines [vcf~]'s frequency range (300-16000 Hz);
#X text 102 573 <- smoothes tone changes \, makes a sort of pitch glide between droplets;
#X text 106 607 <- defines resonance range;
#X text 106 634 <- defines lower resonance value (resonance varies from 20 to 45);
#X text 85 666 <- is used to make noise impulses "ring" like water streams;
#X text 78 390 <- randomises volume of each noise impulse;
#X text 190 67 <- how often single noise impulses are being generated;
#X text 297 877 <- send stereo stream to main.pd;
#X text 135 336 <- amplitude envelope that splits noise to single impulses;
#X text 129 247 Randomising in a certain range and then dividing to that range \, we get random values from 0 to 1 By raising these values to power more than 1 \, we make lower values appear more often (proportionally to that power).;
#X text 130 685 next 8 objects are used to randomise pan and keep it in a range of 50% left - 50% right to have more natural stereo field;
#X text 286 94 receive values from slider in main.pd;
#X text 300 121 these objects define how slider in main patch influences upon various parameters in each water.pd instance;
